<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Documento Limpio</title>
  <style>
    :root{
      --blue:#00AFFA;
      --blue-dark:#0096d6;
      --white:#ffffff;
      --text:#062944;
      --card:#f7fcff;
      --shadow:0 18px 40px rgba(0,0,0,0.18);
    }

    *{box-sizing:border-box;margin:0;padding:0}

    body{
      font-family: Arial, sans-serif;
      background: var(--blue);
      color:var(--text);
      min-height:100vh;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:30px 16px;
    }

    .wrapper{
      width:100%;
      max-width:980px;
    }

    header{
      text-align:center;
      margin-bottom:26px;
    }

    header h1{
      font-size:2.3rem;
      color:#ffffff;
      letter-spacing:1px;
      text-shadow:0 2px 12px rgba(0,0,0,0.15);
    }

    header p{
      margin-top:6px;
      color:#e6f7ff;
      font-size:1rem;
    }

    .panel{
      background:var(--white);
      border-radius:22px;
      box-shadow:var(--shadow);
      padding:28px;
      display:grid;
      grid-template-columns:1.2fr 0.8fr;
      gap:22px;
      position:relative;
      overflow:hidden;
    }

    .panel::before{
      content:"";
      position:absolute;
      top:-80px;
      right:-60px;
      width:220px;
      height:220px;
      background:rgba(0,175,250,0.15);
      border-radius:50%;
    }

    .card{
      border-radius:18px;
      padding:24px;
      background:var(--card);
      border:2px solid #d6f2ff;
    }

    .upload-title{
      font-size:1.2rem;
      margin-bottom:6px;
      color:#0079b2;
      font-weight:bold;
    }

    .upload-sub{
      font-size:0.95rem;
      color:#3c6f8f;
      margin-bottom:16px;
    }

    input[type="file"]{display:none;}

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      padding:12px 20px;
      border-radius:14px;
      background:linear-gradient(135deg, var(--blue) 0%, #37c3ff 100%);
      color:#fff;
      text-decoration:none;
      font-weight:bold;
      border:none;
      cursor:pointer;
      box-shadow:0 10px 18px rgba(0,175,250,0.35);
      transition:transform 0.2s ease, box-shadow 0.3s ease;
    }

    .btn:hover{
      transform:translateY(-2px);
      box-shadow:0 14px 24px rgba(0,175,250,0.45);
    }

    .btn-secondary{
      background:#e9f8ff;
      color:#0079b2;
      border:2px solid #a9e5ff;
      box-shadow:none;
    }

    .status{
      margin-top:16px;
      background:#e9f8ff;
      padding:14px;
      border-radius:12px;
      font-size:0.95rem;
      color:#2b5f7d;
    }

    .right{
      display:flex;
      flex-direction:column;
      gap:14px;
    }

    .info, .download{
      background:#f0fbff;
      border-radius:16px;
      padding:18px;
      border-left:6px solid var(--blue);
    }

    .info h3, .download h3{
      color:#0079b2;
      margin-bottom:8px;
    }

    .download{
      text-align:center;
    }

    /* --- ZONA DE FOTOS --- */
    .photo-box{
      margin-top:14px;
      border-radius:16px;
      overflow:hidden;
      border:2px solid #d6f2ff;
      background:#ffffff;
    }

    .photo-box img{
      width:100%;
      display:block;
    }

    @media (max-width:860px){
      .panel{grid-template-columns:1fr}
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <header>
      <h1>Limpiador de Documentos</h1>
      <p>Sube tu archivo y recibe el documento limpio en segundos</p>
    </header>

    <!-- APARTADO 1: LIMPIEZA -->
    <section class="panel">
      <div class="card">
        <div class="upload-title">Subir Archivo</div>
        <div class="upload-sub">Formatos soportados: PDF, DOCX, TXT</div>

        <label class="btn" for="fileInput">Seleccionar Archivo</label>
        <input id="fileInput" type="file" />

        <div style="margin-top:14px;">
          <button class="btn btn-secondary">Adjuntar y Procesar</button>
        </div>

        <div class="status">
          Estado: Esperando archivo...
        </div>

        <!-- FOTO 1 AQUÍ -->
        <div class="photo-box">
          <img src="imagenes/tu-foto-1.png" alt="Foto relacionada 1"/>
        </div>
      </div>

      <div class="right">
        <div class="info">
          <h3>¿Qué hace el sistema?</h3>
          <p>Elimina errores, limpia formato y entrega un documento optimizado para entregar o imprimir.</p>
        </div>

        <!-- FOTO 2 AQUÍ -->
        <div class="photo-box">
          <img src="imagenes/tu-foto-2.png" alt="Foto relacionada 2"/>
        </div>

        <div class="download">
          <h3>Documento Limpio</h3>
          <p>Cuando termine el proceso, podrás descargarlo aquí.</p>
          <button class="btn">Descargar</button>
        </div>
      </div>
    </section>

    <!-- APARTADO 2: FILTRADO Y COMPARACIÓN -->
    <section class="panel" style="margin-top:26px;">
      <div class="card">
        <div class="upload-title">Filtrado y Comparación de Datos</div>
        <div class="upload-sub">Sube los CSV para filtrar y comparar con la base de datos</div>

        <label class="btn" for="csvA">Subir CSV #1</label>
        <input id="csvA" type="file" accept=".csv" />
        <div style="height:12px;"></div>

        <label class="btn" for="csvB">Subir CSV #2</label>
        <input id="csvB" type="file" accept=".csv" />
        <div style="height:12px;"></div>

        <label class="btn btn-secondary" for="csvBase">Subir Base de Datos (CSV)</label>
        <input id="csvBase" type="file" accept=".csv" />

        <div style="margin-top:16px;">
          <button class="btn">Comparar y Filtrar</button>
        </div>

        <div class="status">
          Estado: Esperando archivos CSV...
        </div>
      </div>

      <div class="right">
        <div class="info">
          <h3>Resultado Final</h3>
          <p>Aquí se mostrarán los datos totalmente distintos después de comparar los 2 CSV con la base de datos.</p>
        </div>

        <div class="download">
          <h3>Descargar Diferencias</h3>
          <p>Cuando termine el proceso, podrás descargar el reporte aquí.</p>
          <button class="btn">Descargar</button>
        </div>

        <!-- FOTO 3 AQUÍ -->
        <div class="photo-box">
          <img src="imagenes/tu-foto-3.png" alt="Foto relacionada 3"/>
        </div>
      </div>
    </section>
  </div>
</body>
</html>
